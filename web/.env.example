# Copy to .env.local and fill in.

# Worker API (the Express server in ../worker). The browser reaches it only
# through the web app's proxy (/api/worker), signed in.
WORKER_URL=http://localhost:4000

# Signs the demo login cookie. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Demo accounts: node scripts/add-user.mjs <username> "<display name>" <password>
AUTH_SECRET=

# Optional: lets "프롬프트 다듬기" use Claude. Without it the built-in template
# converter answers instead (common words only, free). Server-side only.
ANTHROPIC_API_KEY=
